{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skill_commands",
  "type": "object",
  "required": ["schema", "version", "commands"],
  "properties": {
    "schema": { "const": "skill_commands" },
    "version": { "type": "string" },
    "generated_at": { "type": "string" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "args": { "type": "string" },
          "source": { "enum": ["sms", "skill"] },
          "skill_id": { "type": "string" }
        }
      }
    }
  }
}
